{
  "name": "sendikko-root",
  "version": "1.0.0",
  "description": "Sendikko Private File Sharing Platform",
  "scripts": {
    "postinstall": "cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "start": "cd server && npm run start",
    "db:push": "cd server && npm run prisma:push",
    "deploy:frontend": "npm run build:client && npx -y firebase-tools@latest deploy --only hosting",
    "test": "cd server && NODE_ENV=test npx tsx --test ../tests/crypto.test.ts ../tests/chunking.test.ts ../tests/api.test.ts ../tests/diagnostic.test.ts"
  }
}
